# Playwright MCP scratch output — page snapshots, console logs, traces written
# by the browser server during a session. Development artefacts, never source.
.playwright-mcp/
test-results/

node_modules/

# Local, per-developer Claude Code settings
.claude/settings.local.json
.perf-audit/
.playwright-mcp/

# Ephemeral git worktrees created for isolated review agents.
.claude/worktrees/

# Environment files AT THE REPOSITORY ROOT ONLY. `.env.test.local` was committed
# here once by accident: Next reads env files from the app directory (website/),
# never from the repo root, so a copy here configures nothing and is pure
# confusion. website/.gitignore covers the app's own env files; these patterns
# are deliberately root-anchored so they cannot reach into it.
/.env
/.env.*

# Browser-testing screenshots dropped at the root. Root-anchored on purpose:
# an unanchored *.png would silently swallow every product image under
# website/public/images/, which is the opposite of what this is for.
/*.png
