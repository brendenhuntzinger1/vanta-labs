{
  "manifest_version": 3,
  "name": "Vanta MCP DevTools",
  "version": "0.1.0",
  "description": "Inspect MCP context traffic for local development.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "https://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
