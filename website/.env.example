# Card checkout gateway:
#   live (default) - the seam a real high-risk processor plugs into. Inert
#     until a real integration is registered, so production never invents a
#     "paid" state. Connecting your processor = set the keys below + swap this
#     to your provider name; checkout logic is untouched.
#   mock - a simulated sandbox gateway for development/testing. Card checkout
#     redirects to an internal /pay/mock page where a payment can be approved
#     or declined, driving the real webhook pipeline with FAKE money so the
#     whole order lifecycle (paid → email → inventory → commission → refund)
#     can be tested end to end. Never charges a real card. Do NOT use in prod.
PAYMENT_PROVIDER=live
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
# HMAC secret the processor (and the mock gateway) sign webhook events with.
# In mock mode a fixed dev value is used automatically if this is blank.
# REQUIRED for the live processor: the signed webhook is the authoritative
# "paid" signal. Without it nothing settles and charged orders read unpaid.
PAYMENT_WEBHOOK_SECRET=

# VeyraGate (the live card provider) credentials. Both are REQUIRED for card
# checkout: the charge path throws without them, and on the standard card lane
# it throws AFTER the order row and the inventory hold have been written.
# VEYRA_API_BASE is the API root (e.g. https://api.veyragate.com);
# VEYRA_SECRET_KEY is your server secret and falls back to PAYMENT_SECRET_KEY if
# left blank. /admin/status shows whether these are set.
VEYRA_API_BASE=
VEYRA_SECRET_KEY=

# Master switch for card checkout. Default CLOSED: with this unset, every
# checkout returns 503 rather than creating an order the store can't charge.
CHECKOUT_ENABLED=

# Must be the EXACT public origin the site is served from, including the
# subdomain. It is the processor's return_url + allowed_origin base.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ENABLE_ANALYTICS=false
COMMISSION_HOLD_DAYS=14

# Admin console second factor. After the correct username + password, the admin
# must also enter a 6-digit passcode before a session is issued. Set a
# per-account passcode from the admin Team page (preferred), or set this global
# 6-digit fallback here to enforce the second factor for every admin at once.
# If BOTH are unset, the passcode step is not yet provisioned and login falls
# back to username + password only (so a fresh deployment is never locked out).
ADMIN_ACCESS_CODE=

# --- Apple Pay express checkout (mini-cart) --------------------------------
# All four are required together. Leave the flag off until every one of them is
# set AND the serving host is registered for Apple Pay, or the button renders
# and then fails merchant validation with an opaque error.
#
# Master switch. The express button is hidden entirely unless this is "true".
NEXT_PUBLIC_EXPRESS_CHECKOUT_ENABLED=false
# Comma-separated hosts registered for Apple Pay. Native Apple Pay validates
# the EXACT host serving the page, and the apex and www are DIFFERENT
# registrations — list whichever the browser actually lands on (both is fine).
# e.g. www.example.com,example.com
NEXT_PUBLIC_APPLE_PAY_DOMAINS=
# Shared secret the processor echoes back on every wallet shipping callback.
# It is the ONLY thing authenticating that callback, which is the sole
# computation site for the shipping and tax that get charged. Any long random
# string; set it before enabling the flag.
VEYRA_SHIPPING_CALLBACK_TOKEN=

# Scheduled jobs. Vercel Cron hits /api/cron/sweep (membership billing +
# abandoned-cart recovery emails, plus settlement reconciliation for charges
# whose webhook was lost) and must send this as
# "Authorization: Bearer $CRON_SECRET". If unset, the cron route returns 401
# and those scheduled jobs never run.
CRON_SECRET=

# Recurring subscription (membership) billing backend:
#   noop (default) - records intent but never charges, until a real recurring
#     processor is connected.
#   mock - simulated recurring charges for testing the full subscription
#     state machine (intro charge, renewals, dunning/past-due) with fake money.
#     A charge succeeds unless the stored payment method marks a decline test
#     card. Never charges a real card; do NOT use in production.
BILLING_PROVIDER=noop

# Transactional email (contact form, order confirmations, ambassador
# emails, etc.) - see src/lib/email/ and README-partner-portal.md for setup.
# EMAIL_PROVIDER selects the backend: smtp (default) | resend | sendgrid.
# Delivery is NOT claimed working until one of these is fully configured -
# an unconfigured/misconfigured provider fails the send safely without
# blocking whatever triggered it (an order, an approval, etc.).
# Master on/off switch for all outbound email. Leave blank/false to keep
# email disabled (sends are safely skipped) until a provider is configured.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=

# Secret used to sign one-click unsubscribe links. Falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset; set a dedicated value in production.
UNSUBSCRIBE_SECRET=

# smtp provider (also used for AWS SES - point SMTP_HOST at your SES SMTP
# endpoint and use your SES SMTP credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# resend provider
RESEND_API_KEY=

# sendgrid provider
SENDGRID_API_KEY=

# 3PL / fulfillment provider (optional; stays in "manual" mode until set).
# When your 3PL is connected, set these; paid orders are then transmitted
# automatically and the inbound status webhook is verified with the secret.

# Legacy aliases (not used directly in code)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shipping labels (Shippo). Server-side only — never NEXT_PUBLIC_.
# A shippo_test_... token simulates labels; shippo_live_... buys real postage.
SHIPPO_API_TOKEN=

# TikTok Events API — server-side conversion reporting.
# Generated in Events Manager → your pixel → Set up Events API. Server-side
# only: it is read in a route handler, sent in an Access-Token header, and must
# never be prefixed NEXT_PUBLIC_ or referenced from client code.
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# TikTok Pixel (browser). NOT a secret — it ships to every visitor by design
# and identifies the ad account's data source, not any credential. Leave unset
# to use the built-in VANTA LABS–MAIN WEBSITE pixel; set it only to point a
# staging deployment at a different data source. It must match the pixel the
# Events API token was generated for, or the browser and server halves report
# to two different places and neither deduplicates.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# TikTok Ads Management + Reporting. A DIFFERENT credential from the Events API
# token above: that one reports conversions, these read campaigns and spend and
# can change them. Both are required together before /admin/ads shows real
# campaign data; until then it renders a "not connected" state.
TIKTOK_ADVERTISER_ID=
TIKTOK_ADS_ACCESS_TOKEN=

# Snap Pixel (browser). Same nature as the TikTok pixel id above: not a secret,
# ships to every visitor, identifies the ad account's data source. Leave unset
# to use the built-in Vanta Labs pixel; set it only to point a staging
# deployment somewhere else. The pixel is loaded only after cookie consent, and
# it is initialised with this id and nothing else — no email is ever sent to
# Snap, so the 'user_email' placeholder in Snapchat's generated snippet has no
# equivalent here and must not be reintroduced.
NEXT_PUBLIC_SNAP_PIXEL_ID=

# Master switch for TikTok ad WRITES (create/pause/enable campaigns, budgets).
# Deliberately separate from TIKTOK_ADS_ACCESS_TOKEN: the token turns on
# READING spend and performance, and nothing else. Leave unset — set it to
# exactly "true" only when you have decided the system may spend money.
TIKTOK_ADS_WRITE_ENABLED=

# ===========================================================================
# SHIPPING — WEBHOOK AUTHENTICATION
# ===========================================================================

# Shared secret proving a Shippo webhook delivery is genuinely from Shippo.
# Shippo signs nothing, so this is the only access control on the endpoint,
# and that endpoint moves orders to In Transit and Delivered, sends the
# customer's shipping and delivery emails, and records the actual postage that
# lands in profit.
#
# Generate any long random string, then set the SAME value in two places:
#   1. here / Vercel (Production AND Preview)
#   2. the Shippo webhook URL, as a query parameter:
#        https://<site>/api/webhooks/shippo?secret=<the same value>
#      (an x-shippo-webhook-secret header works too, if Shippo ever adds
#      custom headers)
#
# FAILS CLOSED. Unset -> the endpoint answers 503 and rejects every delivery,
# so tracking silently stops updating and no shipping emails go out. Wrong
# value -> 401. Both sides are trimmed, so trailing whitespace is harmless.
SHIPPO_WEBHOOK_SECRET=

# ===========================================================================
# OPERATIONS
# ===========================================================================

# Where critical system alerts are emailed (unattributable Shippo label,
# cron sweep failure, inventory not decremented on a shipped replacement).
# Leave unset and those alerts are recorded in the admin Status page only —
# still visible, but nobody is notified.
ALERT_EMAIL=

# Marketing email identity, kept separate from the transactional sender so a
# campaign cannot damage deliverability of order confirmations.
MARKETING_EMAIL_FROM=

# Physical postal address in the marketing email footer. Required by CAN-SPAM
# for marketing sends. Use the customer-facing business address (the PO Box),
# never a private residential one.
MARKETING_POSTAL_ADDRESS=

# ===========================================================================
# OPTIONAL — ANALYTICS / ANTI-ABUSE
# ===========================================================================

# Reddit advertising. Same split as TikTok: the public pixel id ships to the
# browser, the conversions token is a server secret. Both optional.
NEXT_PUBLIC_REDDIT_PIXEL_ID=
REDDIT_CONVERSIONS_ACCESS_TOKEN=

# Cloudflare Turnstile site key (browser). Optional; unset disables the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ===========================================================================
# ERROR REPORTING (Sentry)
# ===========================================================================
#
# BOTH are needed, and they are not interchangeable. Only NEXT_PUBLIC_ variables
# are inlined into client bundles, so SENTRY_DSN alone reports server errors
# while every browser stays silent — and a Sentry with no browser events looks
# identical to a site with no browser bugs. /api/system-status reports "SERVER
# ONLY" when this is the case; treat that as a real gap, not a warning to skip.
#
# The value is the full URL from Sentry (https://<key>@<org>.ingest.<region>.
# sentry.io/<projectId>), never the variable's own name — production has run a
# deployment with the literal string "SENTRY_DSN" in the value box, and every
# init threw for that entire deployment.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ===========================================================================
# SHIPPING LABELS
# ===========================================================================
#
# VANTA DOES NOT BUY POSTAGE. Labels are purchased directly in Shippo and sync
# back here with their tracking number and real carrier cost.
#
# Leave this UNSET. Unset means purchaseLabelForOrder refuses, which is what
# stops the fulfillment workstation's batch action from buying postage for a
# whole list of orders by accident. It is an environment variable rather than an
# admin toggle precisely so it cannot be flipped by a mis-click.
#
# Set it to exactly "true" only if the business goes back to buying labels in
# Vanta, and treat that as a deployment decision.
SHIPPO_ALLOW_LABEL_PURCHASE=

# ===========================================================================
# NEVER SET IN PRODUCTION
# ===========================================================================

# Allows the mock payment provider to be selected. A development-only escape
# hatch: with it set, orders can be "paid" without money moving. Production
# must leave this unset.
ALLOW_MOCK_PAYMENTS=

# ===========================================================================
# PROVIDED BY THE PLATFORM — do not set these yourself
# ===========================================================================
#
#   NODE_ENV                 set by the runtime
#   TZ                       set by the runtime
#   VERCEL_ENV               "production" | "preview" | "development"
#   VERCEL_URL               the deployment's own hostname
#   VERCEL_GIT_COMMIT_SHA    the deployed commit, shown in admin diagnostics
#   NEXT_PUBLIC_BUILD_ID     derived at build time
#   NEXT_PUBLIC_BUILD_TIME   derived at build time
